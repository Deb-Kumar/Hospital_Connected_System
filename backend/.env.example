PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=

# Use a long random string — do NOT reuse the one from any previous commit
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Email (for OTP + notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

# Frontend origin allowed by CORS (React web app)
CLIENT_URL=http://localhost:5173
WEB_APP_URL=http://localhost:5173

# Fast2SMS (Indian SMS)
FAST2SMS_API_KEY=

# Cloudinary — durable file storage for medical records.
# Required in production (Render's filesystem is ephemeral). If left blank,
# uploaded files fall back to local disk under backend/uploads/, which is
# fine for local development only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared secret required to call POST /api/auth/dev-reset. That route is also
# fully disabled when NODE_ENV=production, regardless of this value.
DEV_RESET_KEY=
