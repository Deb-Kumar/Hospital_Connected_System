<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="120dp">

            <!-- Top Header Action Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_home_menu"
                    android:contentDescription="Menu" />

                <ImageView
                    android:id="@+id/btnNotification"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_notification_bell"
                    android:contentDescription="Notifications" />
            </RelativeLayout>

            <!-- User Greeting Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome back,"
                        android:textColor="#757575"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#1A237E"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Debkumar Payra" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hope you are doing well!"
                        android:textColor="#757575"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivUserAvatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_user_circle" />
            </RelativeLayout>

            <!-- Blue Gradient Health Banner Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_home_banner"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:orientation="vertical"
                        android:layout_toStartOf="@id/ivHospitalIllustration">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_banner_shield"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your Health is\nOur Priority"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:lineSpacingExtra="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Trusted Care, Better Health"
                            android:textColor="#E3F2FD"
                            android:textSize="11sp"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivHospitalIllustration"
                        android:layout_width="120dp"
                        android:layout_height="90dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_hospital_illustration" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quick Actions Container Card (8 Grid Items) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick Actions"
                        android:textColor="#1A237E"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="14dp" />

                    <!-- Grid Row 1 (4 Columns) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4"
                        android:layout_marginBottom="12dp">

                        <!-- Item 1: Book Appointment (Light Blue) -->
                        <LinearLayout
                            android:id="@+id/actionBook"
                            android:layout_width="0dp"
                            android:layout_height="88dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_tile_card"
                            android:backgroundTint="#E3F2FD"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_qa_book_app" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Book\nAppointment"
                                android:textColor="#1565C0"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Item 2: Doctor Consultation (Light Green) -->
                        <LinearLayout
                            android:id="@+id/actionDoctorConsult"
                            android:layout_width="0dp"
                            android:layout_height="88dp"
                            android:layout_weight="1"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/bg_tile_card"
                            android:backgroundTint="#E8F5E9"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_qa_doctor" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Doctor\nConsultation"
                                android:textColor="#2E7D32"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Item 3: My Reports (Light Purple) -->
                        <LinearLayout
                            android:id="@+id/actionMyReports"
                            android:layout_width="0dp"
                            android:layout_height="88dp"
                            android:layout_weight="1"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/bg_tile_card"
                            android:backgroundTint="#F3E5F5"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_qa_reports" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="My\nReports"
                                android:textColor="#7B1FA2"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Item 4: Prescriptions (Light Orange) -->
                        <LinearLayout
                            android:id="@+id/actionPrescriptions"
                            android:layout_width="0dp"
                            android:layout_height="88dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_tile_card"
                            android:backgroundTint="#FFF3E0"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_qa_rx" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Prescriptions"
                                android:textColor="#E65100"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Grid Row 2 (4 Columns) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <!-- Item 5: Medical Records (Light Teal) -->
                        <LinearLayout
                            android:id="@+id/actionRecords"
                            android:layout_width="0dp"
                            android:layout_height="88dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_tile_card"
                            android:backgroundTint="#E0F2F1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_qa_records" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Medical\nRecords"
                                android:textColor="#00695C"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Item 6: Billing & Payments (Light Gold) -->
                        <LinearLayout
                            android:id="@+id/actionBilling"
                            android:layout_width="0dp"
                            android:layout_height="88dp"
                            android:layout_weight="1"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/bg_tile_card"
                            android:backgroundTint="#FFF8E1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_qa_billing" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Billing &amp;\nPayments"
                                android:textColor="#F57F17"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Item 7: Health Packages (Light Pink) -->
                        <LinearLayout
                            android:id="@+id/actionHealthPackages"
                            android:layout_width="0dp"
                            android:layout_height="88dp"
                            android:layout_weight="1"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/bg_tile_card"
                            android:backgroundTint="#FCE4EC"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_qa_packages" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Health\nPackages"
                                android:textColor="#C2185B"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Item 8: Find Hospital (Light Indigo) -->
                        <LinearLayout
                            android:id="@+id/actionFindHospital"
                            android:layout_width="0dp"
                            android:layout_height="88dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_tile_card"
                            android:backgroundTint="#E8EAF6"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_qa_hospital" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Find\nHospital"
                                android:textColor="#283593"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Upcoming Appointment Section Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Upcoming Appointment"
                    android:textColor="#1A237E"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnViewAllAppointments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="View All"
                    android:textColor="#1E88E5"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <!-- Upcoming Appointment Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:id="@+id/layoutUpcoming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/ivDoctorAvatar"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_user_circle" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/ivDoctorAvatar"
                            android:layout_toStartOf="@id/tvStatusBadge"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvUpcomingDoctor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#212121"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="Dr. Arindam Sen" />

                            <TextView
                                android:id="@+id/tvUpcomingSpecialty"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#757575"
                                android:textSize="13sp"
                                android:layout_marginTop="1dp"
                                tools:text="Cardiologist" />
                        </LinearLayout>

                        <!-- Confirmed Pill Badge -->
                        <TextView
                            android:id="@+id/tvStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_tile_card"
                            android:backgroundTint="#E8F5E9"
                            android:textColor="#2E7D32"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="Confirmed" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Date & Time Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_qa_book_app"
                            app:tint="#757575" />

                        <TextView
                            android:id="@+id/tvUpcomingDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="#616161"
                            android:textSize="12sp"
                            tools:text="25 May 2025  •  11:00 AM" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoUpcoming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:gravity="center"
                    android:text="No upcoming appointments. Book an appointment above."
                    android:textColor="#757575"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </androidx.cardview.widget.CardView>

            <!-- Health Tips Section Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Health Tips"
                    android:textColor="#1A237E"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnViewAllTips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="View All"
                    android:textColor="#1E88E5"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <!-- Health Tips Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F1F8E9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_heartbeat" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp"
                        android:text="Stay hydrated and eat healthy food to keep your body and mind healthy."
                        android:textColor="#33691E"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Hidden Departments List RecyclerView for logic compatibility -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDepartments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#D32F2F"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
