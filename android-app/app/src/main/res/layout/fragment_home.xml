<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Hospital.Title"
                android:textSize="20sp"
                tools:text="Good Morning, Priya" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="How can we help you today?"
                android:textAppearance="@style/TextAppearance.Hospital.Body" />

            <!-- Upcoming appointment -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Hospital.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/deep_navy">

                <LinearLayout
                    android:id="@+id/layoutUpcoming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Upcoming Appointment"
                        android:textColor="#B8C4D9"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvUpcomingDoctor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/clinical_white"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="Dr. Anjali Sharma" />

                    <TextView
                        android:id="@+id/tvUpcomingDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#D8E1F0"
                        tools:text="Cardiology · 20 Aug, 10:30 AM · Token A-024" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoUpcoming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No upcoming appointments. Book one below."
                    android:textColor="@color/clinical_white"
                    android:visibility="gone" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Quick actions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Quick Actions"
                android:textAppearance="@style/TextAppearance.Hospital.Title"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include layout="@layout/item_quick_action" android:id="@+id/actionBook"
                        android:layout_width="0dp" android:layout_weight="1" />
                    <include layout="@layout/item_quick_action" android:id="@+id/actionAppointments"
                        android:layout_width="0dp" android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include layout="@layout/item_quick_action" android:id="@+id/actionRecords"
                        android:layout_width="0dp" android:layout_weight="1" />
                    <include layout="@layout/item_quick_action" android:id="@+id/actionFindDoctor"
                        android:layout_width="0dp" android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include layout="@layout/item_quick_action" android:id="@+id/actionDigitalId"
                        android:layout_width="0dp" android:layout_weight="1" />
                    <include layout="@layout/item_quick_action" android:id="@+id/actionEmergency"
                        android:layout_width="0dp" android:layout_weight="1" />
                </LinearLayout>

            </LinearLayout>

            <!-- Departments preview -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Departments"
                android:textAppearance="@style/TextAppearance.Hospital.Title"
                android:textSize="16sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDepartments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/error_red"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
