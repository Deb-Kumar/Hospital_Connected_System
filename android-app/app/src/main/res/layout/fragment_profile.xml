<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="12dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textAppearance="@style/TextAppearance.Hospital.Title"
                android:textSize="18sp"
                tools:text="Priya Sharma" />

            <TextView
                android:id="@+id/tvPatientId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                tools:text="Patient ID: 66f3a1..." />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Hospital.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView android:id="@+id/tvEmail" style="@style/TextAppearance.Hospital.Body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" tools:text="priya@example.com" />

                <TextView android:id="@+id/tvPhone" style="@style/TextAppearance.Hospital.Body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" tools:text="+91 98765 43210" />

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/cool_gray" android:layout_marginTop="14dp" android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Health Information"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView android:id="@+id/tvBloodGroup" style="@style/TextAppearance.Hospital.Body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" tools:text="Blood Group: O+" />

                <TextView android:id="@+id/tvAge" style="@style/TextAppearance.Hospital.Body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" tools:text="Age: 29" />

                <TextView android:id="@+id/tvAllergies" style="@style/TextAppearance.Hospital.Body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" tools:text="Allergies: None reported" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditProfile"
            style="@style/Widget.Hospital.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/edit_profile" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDigitalId"
            style="@style/Widget.Hospital.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/digital_id" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFamilyMembers"
            style="@style/Widget.Hospital.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/family_members" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccountSettings"
            style="@style/Widget.Hospital.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Account Settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/error_red"
            android:textAllCaps="false"
            app:cornerRadius="12dp"
            android:text="@string/logout" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/error_red"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
